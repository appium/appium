// Architecture of @appium/archward, checked by `archward` itself (see ../README.md).
// Each component owns the files in `metadata.paths`; each `a -> b` ALLOWS a to import b.
model {
  archward = container '@appium/archward' {
    api = component 'index.ts' {
      description 'Public programmatic entry point; re-exports only.'
      metadata { paths 'lib/index.ts' }
    }
    cli = component 'cli.ts' {
      description 'Argument parsing, exit codes and printing for the `archward` command.'
      metadata { paths 'lib/cli.ts' }
    }
    check = component 'check.ts' {
      description 'Runs one package check: analysis, baseline comparison and baseline updates.'
      metadata { paths 'lib/check.ts' }
    }
    analysis = component 'analysis' {
      description 'Reads the model and the import graph; finds boundary, cycle and package-import violations.'
      metadata { paths 'lib/analysis/**' }
    }
    init = component 'init' {
      description 'Derives a starting model and baseline from the current code (`archward init`).'
      metadata { paths 'lib/init/**' }
    }
    baseline = component 'baseline.ts' {
      description 'Reads, writes and diffs the tolerated-violations baseline.'
      metadata { paths 'lib/baseline.ts' }
    }
    config = component 'config.ts' {
      description 'Loads and validates `architecture/config.json`.'
      metadata { paths 'lib/config.ts' }
    }
    report = component 'report.ts' {
      description 'Formats check results for humans.'
      metadata { paths 'lib/report.ts' }
    }
    workspaces = component 'workspaces.ts' {
      description 'Finds the packages of an npm workspaces monorepo.'
      metadata { paths 'lib/workspaces.ts' }
    }
    types = component 'types.ts' {
      description 'Shared types. Depends on nothing.'
      metadata { paths 'lib/types.ts' }
    }
    util = component 'util.ts' {
      description 'Small dependency-free helpers.'
      metadata { paths 'lib/util.ts' }
    }
  }

  archward.cli -> archward.check
  archward.cli -> archward.init
  archward.cli -> archward.report
  archward.cli -> archward.workspaces
  archward.api -> archward.check
  archward.api -> archward.config
  archward.api -> archward.init
  archward.api -> archward.report
  archward.api -> archward.types
  archward.api -> archward.workspaces
  archward.check -> archward.analysis
  archward.check -> archward.baseline
  archward.check -> archward.config
  archward.check -> archward.types
  archward.check -> archward.util
  archward.init -> archward.analysis
  archward.init -> archward.check
  archward.init -> archward.config
  archward.init -> archward.types
  archward.init -> archward.util
  archward.analysis -> archward.types
  archward.analysis -> archward.util
  archward.baseline -> archward.config
  archward.baseline -> archward.types
  archward.baseline -> archward.util
  archward.config -> archward.types
  archward.report -> archward.types
  archward.workspaces -> archward.config
}
