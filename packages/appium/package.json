{
  "name": "appium",
  "version": "4.0.0-beta.1",
  "gitHead": "f7b20335eab4022e5cbbb627ec86866a994444f8",
  "description": "Automation for Apps.",
  "keywords": [
    "android",
    "automation",
    "firefoxos",
    "ios",
    "javascript",
    "selenium",
    "testing",
    "webdriver"
  ],
  "homepage": "https://appium.io",
  "bugs": {
    "url": "https://github.com/appium/appium/issues"
  },
  "license": "Apache-2.0",
  "author": "https://github.com/appium",
  "repository": {
    "type": "git",
    "url": "https://github.com/appium/appium.git",
    "directory": "packages/appium"
  },
  "bin": {
    "appium": "index.js"
  },
  "directories": {
    "lib": "./lib"
  },
  "files": [
    "lib",
    "build/lib",
    "build/types",
    "index.js",
    "driver.*",
    "support.*",
    "plugin.*",
    "types",
    "tsconfig.json",
    "!scripts/ci"
  ],
  "type": "module",
  "main": "./build/lib/main.js",
  "types": "./build/lib/main.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:docs": "node docs/scripts/build-docs.js",
    "build:docs:preview": "cross-env APPIUM_DOCS_PREVIEW=1 npm run build:docs",
    "build:docs:cli": "node docs/scripts/gen-cli-args-docs.js",
    "build:docs:reference": "node docs/scripts/build-reference.js",
    "dev:docs": "npm run dev:docs:en",
    "dev:docs:en": "appium-docs build --serve --mkdocs-yml ./docs/mkdocs-en.yml",
    "dev:docs:ja": "appium-docs build --serve --mkdocs-yml ./docs/mkdocs-ja.yml",
    "dev:docs:zh": "appium-docs build --serve --mkdocs-yml ./docs/mkdocs-zh.yml",
    "install-docs-deps": "appium-docs init --no-mkdocs",
    "publish:docs": "cross-env APPIUM_DOCS_PUBLISH=1 npm run build:docs",
    "test": "npm run test:unit",
    "test:e2e": "node --test --experimental-test-module-mocks --enable-source-maps --test-force-exit --test-concurrency=1 --test-timeout=200000 \"./build/test/e2e/**/*.spec.js\"",
    "test:smoke": "cross-env APPIUM_HOME=./local_appium_home node ./scripts/ci/smoke-install-known-driver.mjs uiautomator2 && cross-env APPIUM_HOME=./local_appium_home node ./index.js driver list",
    "test:unit": "node --test --experimental-test-module-mocks --test-concurrency=1 --enable-source-maps --test-timeout=5000 \"./build/test/unit/**/*.spec.js\""
  },
  "dependencies": {
    "@appium/base-driver": "11.0.0-beta.0",
    "@appium/base-plugin": "4.0.0-beta.0",
    "@appium/docutils": "4.0.0-beta.0",
    "@appium/http-server": "1.0.0-beta.0",
    "@appium/logger": "3.0.0-beta.0",
    "@appium/schema": "2.0.0-beta.0",
    "@appium/support": "8.0.0-beta.0",
    "@appium/types": "2.0.0-beta.0",
    "@sidvind/better-ajv-errors": "7.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "argparse": "3.0.0",
    "asyncbox": "6.4.2",
    "axios": "1.19.0",
    "lilconfig": "3.1.3",
    "lru-cache": "11.5.2",
    "normalize-package-data": "8.0.0",
    "ora": "5.4.1",
    "semver": "7.8.5",
    "teen_process": "4.2.1",
    "type-fest": "5.8.0",
    "winston": "3.19.0",
    "ws": "8.21.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/json-schema": "7.0.15",
    "winston-transport": "4.9.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=10"
  }
}
