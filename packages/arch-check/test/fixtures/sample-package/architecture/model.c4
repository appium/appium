model {
  sample = container 'sample' {
    app = component 'app' {
      metadata { paths 'lib/app.ts' }
    }
    services = component 'services' {
      metadata { paths 'lib/services/**' }
    }
    util = component 'util' {
      metadata { paths 'lib/util/**' }
    }
    extras = component 'extras' {
      metadata { paths 'lib/extras/**' }
    }
  }

  sample.app -> sample.services
  sample.app -> sample.util
  sample.services -> sample.util
}
