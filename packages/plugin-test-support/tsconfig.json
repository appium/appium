{
  "extends": "@appium/tsconfig/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "rootDir": ".",
    "outDir": "build",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@appium/types": ["../types"],
      "appium/support.js": ["../appium/support.d.ts"],
      "appium": ["../appium"]
    },
    "types": ["node"]
  },
  "include": ["./lib"],
  "references": [{"path": "../types"}, {"path": "../support"}, {"path": "../appium"}]
}
